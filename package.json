{
  "name": "seller-net-sheet-cma",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Seller net sheet and CMA listing presentation for real estate agents. Static browser app, nothing uploaded. A CMA is a broker opinion, not an appraisal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
